#!/usr/bin/env bash
set -euo pipefail

TMP_DIR=$(mktemp -d)
trap 'rm -rf "$TMP_DIR"' EXIT

install_fonts() {
  local dest=$1
  shift
  mkdir -p /usr/share/fonts/$dest
  find "$@" -type f \( -name '*.ttf' -o -name '*.otf' \) -exec cp "{}" /usr/share/fonts/$dest/ \;
  fc-cache -f /usr/share/fonts/$dest
}

mkdir -p "$TMP_DIR/maple-mono"
curl -fsSLo "$TMP_DIR/maple-mono.zip" "https://github.com/subframe7536/maple-font/releases/latest/download/MapleMono-NF-CN.zip"
unzip -q "$TMP_DIR/maple-mono.zip" -d "$TMP_DIR/maple-mono"
install_fonts maple-mono "$TMP_DIR/maple-mono"

if ! command -v 7z >/dev/null 2>&1; then
  dnf install -y 7zip
fi

mkdir -p "$TMP_DIR/lxgw-gb" "$TMP_DIR/lxgw-tc"
curl -fsSLo "$TMP_DIR/LXGWBrightGB.7z" "https://github.com/lxgw/LxgwBright/releases/latest/download/LXGWBrightGB.7z"
curl -fsSLo "$TMP_DIR/LXGWBrightTC.7z" "https://github.com/lxgw/LxgwBright/releases/latest/download/LXGWBrightTC.7z"
7z x -y -o"$TMP_DIR/lxgw-gb" "$TMP_DIR/LXGWBrightGB.7z" >/dev/null
7z x -y -o"$TMP_DIR/lxgw-tc" "$TMP_DIR/LXGWBrightTC.7z" >/dev/null
install_fonts lxgw-bright "$TMP_DIR/lxgw-gb" "$TMP_DIR/lxgw-tc"
