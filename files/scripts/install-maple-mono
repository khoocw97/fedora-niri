#!/usr/bin/env bash
set -euo pipefail

TMP_DIR=$(mktemp -d)
trap 'rm -rf "$TMP_DIR"' EXIT

# Query the GitHub API for the latest release asset URL
API=$(curl -fsSL https://api.github.com/repos/subframe7536/maple-font/releases/latest)

ZIP_URL=$(echo "$API" | grep -oP '"browser_download_url":\s*"\K[^"]+(?=")' | grep 'MapleMono-NF-CN\.zip$')

curl -fsSLo "$TMP_DIR/maple-mono.zip" "$ZIP_URL"

mkdir -p "$TMP_DIR/maple-mono"
unzip -q "$TMP_DIR/maple-mono.zip" -d "$TMP_DIR/maple-mono"

mkdir -p /usr/share/fonts/maple-mono
find "$TMP_DIR/maple-mono" -type f \( -name '*.ttf' -o -name '*.otf' \) -exec cp "{}" /usr/share/fonts/maple-mono/ \;

fc-cache -f /usr/share/fonts/maple-mono