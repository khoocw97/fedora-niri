#!/usr/bin/env bash
set -euo pipefail

# Ostree convention: /home must be a symlink to /var/home.
#
# User home dirs live under /var/home (persistent), and /etc/passwd points
# every user at /var/home/<user>. If the deployed system ends up with a real
# /home directory instead of the symlink, greetd fails to chdir to the user's
# home at login ("unable to set working directory") and user data is not
# persistent across rebases.
if [ -L /home ]; then
    exit 0
fi
if [ -d /home ]; then
    rm -rf /home
fi
mkdir -p /var/home
ln -s /var/home /home
