#!/usr/bin/env bash
set -oeux pipefail

# ensure the script plugin (script.so) is present; plymouth-set-default-theme
# refuses to switch to a script-based theme without it
if ! rpm -q plymouth-plugin-script >/dev/null 2>&1; then
  dnf install -y plymouth-plugin-script
fi

# ensure the tool that sets the default theme is present
if ! rpm -q plymouth-scripts >/dev/null 2>&1; then
  dnf install -y plymouth-scripts
fi

plymouth-set-default-theme loader
