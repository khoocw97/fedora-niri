#!/usr/bin/env bash
set -euo pipefail

# SDL_GameControllerDB has no release assets (it's a single repo file),
# so pin the download to the latest commit SHA from the GitHub API.
API=$(curl -fsSL https://api.github.com/repos/mdqinc/SDL_GameControllerDB/commits/master)
SHA=$(echo "$API" | grep -oP '"sha":\s*"\K[0-9a-f]{40}' | head -1)
URL="https://raw.githubusercontent.com/mdqinc/SDL_GameControllerDB/$SHA/gamecontrollerdb.txt"

mkdir -p /usr/share/SDL2
curl -fsSLo /usr/share/SDL2/gamecontrollerdb.txt "$URL"

echo "SDL GameControllerDB ($SHA) installed to /usr/share/SDL2/gamecontrollerdb.txt"