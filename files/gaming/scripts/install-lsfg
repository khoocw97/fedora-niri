#!/usr/bin/env bash
set -euo pipefail

echo "Installing lsfg-vk (Lossless Scaling vulkan layer)..."

# Latest release URL (1.0.0). Bump when a new release ships.
LSFG_VERSION="1.0.0"
curl -fLo /tmp/lsfg-vk.rpm "https://github.com/PancakeTAS/lsfg-vk/releases/download/v${LSFG_VERSION}/lsfg-vk-${LSFG_VERSION}.x86_64.rpm"

dnf install -y --setopt=tsflags=noscripts /tmp/lsfg-vk.rpm
rm -f /tmp/lsfg-vk.rpm

echo "lsfg-vk installed to /usr/lib64/liblsfg-vk.so"
