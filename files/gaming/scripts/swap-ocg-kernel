#!/usr/bin/env bash
set -xeuo pipefail

# 1. 移除原 main 内核 (同 MizukiOS/files/scripts/swap-kernel.sh:3-5)
for pkg in kernel kernel-core kernel-modules kernel-modules-core kernel-modules-extra; do
  rpm --erase "${pkg}" --nodeps || true
done

# 2. 禁用 rpm-ostree/dracut 钩子 (MizukiOS:7-11)
pushd /usr/lib/kernel/install.d
printf '%s\n' '#!/bin/sh' 'exit 0' > 05-rpmostree.install
printf '%s\n' '#!/bin/sh' 'exit 0' > 50-dracut.install
chmod +x 05-rpmostree.install 50-dracut.install
popd

# 3. 拉取 ogc 内核缓存 (已验证 ghcr.io/ublue-os/akmods:ogc-44 的 /kernel-rpms/kernel-7.2.3-ogc*)
skopeo copy --retry-times 3 docker://ghcr.io/ublue-os/akmods:ogc-44 dir:/tmp/akmods
AKMODS_TGZ=$(jq -r '.layers[].digest' /tmp/akmods/manifest.json | cut -d: -f2)
tar -xzf "/tmp/akmods/${AKMODS_TGZ}" -C /tmp

# 4. 安装 ogc 内核
dnf -y install /tmp/kernel-rpms/*.rpm

# 可选验证
rpm -qa | grep -E '^kernel-7\.2\.3-ogc' || true
